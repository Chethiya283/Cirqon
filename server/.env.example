# Server Configuration
PORT=5000

# MongoDB Connection URI
# Example Atlas connection string:
# mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/<database>?retryWrites=true&w=majority
# Example local MongoDB instance:
# mongodb://localhost:27017/cirqon
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/cirqon?retryWrites=true&w=majority

# JWT Authentication Secret Placeholder
JWT_SECRET=your_jwt_secret_key_placeholder


